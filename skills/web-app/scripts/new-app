#!/usr/bin/env bash
#
# new-app — зарегистрировать, собрать и запустить веб-приложение.
#
# Контракт (план agent/bot 2026-09-26-agent-webapps, §2/§6):
#   1. POST /apps — ДО взятия flock
#   2. Сборка (python3-venv, каталог, venv) — под flock /run/agent-apps.lock
#   3. Перепроверка id у бота — ПЕРЕД start: удаление за время постройки не оживает
#   4. systemd-юнит DynamicUser=yes + health-проверка /app-health
#
# Ссылка печатается ТОЛЬКО после успешной health-проверки.
# Шаблон VM не пересобирается: python3-venv ставится здесь же, при необходимости.
set -euo pipefail

NAME="${1:-}"
CONF_DIR="/etc/agent-apps"
LOCK_FILE="/run/agent-apps.lock"
APPS_DIR="/opt/agent-apps"
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE_DIR="$SKILL_DIR/template"

# --- параметры из машины ---
for f in key api-url; do
    if [ ! -r "$CONF_DIR/$f" ]; then
        echo "ОШИБКА: $CONF_DIR/$f не читается — веб-приложения не раскатаны на эту машину." >&2
        echo "Попросите владельца: «🌐 Приложения» в боте." >&2
        exit 1
    fi
done
API_KEY=$(cat "$CONF_DIR/key")
API_URL=$(cat "$CONF_DIR/api-url")

# --- валидация имени ---
if [ -z "$NAME" ] || ! echo "$NAME" | grep -qE '^[a-z0-9-]{1,32}$'; then
    echo "ОШИБКА: имя — строчные латиница, цифры и дефис, до 32 знаков: $NAME" >&2
    exit 1
fi

json_field() { printf '%s' "$1" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[sys.argv[1]])" "$2" 2>/dev/null; }

# ====================== 1. РЕГИСТРАЦИЯ (до flock) =============================
# Повтор имени идемпотентен: 409 + существующая запись — тот же id и порт.
HTTP_CODE=$(curl -s -o /tmp/webapp-reg.json -w '%{http_code}' \
    -X POST "$API_URL/apps" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"$NAME\"}" \
    --connect-timeout 5 --max-time 15) || {
    echo "ОШИБКА: бот не ответил ($API_URL). Проверьте оплату периода." >&2
    exit 1
}

case "$HTTP_CODE" in
    201|409)
        APP_ID=$(json_field "$(cat /tmp/webapp-reg.json)" id) || {
            echo "ОШИБКА: не удалось разобрать ответ бота." >&2
            cat /tmp/webapp-reg.json >&2
            exit 1
        }
        PORT=$(json_field "$(cat /tmp/webapp-reg.json)" port)
        BASE_PATH=$(json_field "$(cat /tmp/webapp-reg.json)" base_path)
        APP_URL=$(json_field "$(cat /tmp/webapp-reg.json)" url)
        rm -f /tmp/webapp-reg.json
        ;;
    *)
        echo "ОШИБКА: регистрация отклонена (HTTP $HTTP_CODE)." >&2
        cat /tmp/webapp-reg.json >&2 2>/dev/null
        echo "Возможно: лимит приложений, нет оплаченного периода." >&2
        rm -f /tmp/webapp-reg.json
        exit 1
        ;;
esac

echo "Зарегистрировано: id=$APP_ID порт=$PORT"

APP_DIR="$APPS_DIR/$APP_ID"
UNIT_NAME="agentapp-$APP_ID"
UNIT_FILE="/etc/systemd/system/$UNIT_NAME.service"

# ====================== 2. СБОРКА (под flock) ==================================
exec 9>"$LOCK_FILE"
flock -w 30 9

# --- python3-venv: шаблон не пересобирается, ставим при необходимости ---
# Без ensurepip venv создаётся пустым и pip в нём нет.
if ! python3 -c "import ensurepip" 2>/dev/null; then
    PY_VER=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    sudo apt-get install -y -qq "python${PY_VER}-venv" 2>/dev/null || \
    sudo apt-get install -y -qq python3-venv 2>/dev/null || {
        echo "ОШИБКА: не удалось установить python3-venv." >&2
        exit 1
    }
fi

# --- каталог и код ---
sudo mkdir -p "$APP_DIR/static"
sudo cp "$TEMPLATE_DIR/main.py" "$APP_DIR/"
sudo cp "$TEMPLATE_DIR/requirements.txt" "$APP_DIR/"
sudo cp "$TEMPLATE_DIR/static/index.html" "$APP_DIR/static/"

# --- venv (повтор — no-op) ---
if [ ! -x "$APP_DIR/venv/bin/pip" ]; then
    echo "Сборка окружения (30-60 секунд)…"
    sudo rm -rf "$APP_DIR/venv"
    sudo python3 -m venv "$APP_DIR/venv"
    sudo "$APP_DIR/venv/bin/pip" install --quiet --no-input \
        -r "$APP_DIR/requirements.txt"
fi

# ====================== 3. ПЕРЕПРОВЕРКА (под flock, ПЕРЕД start) ==============
# Удаление, пришедшее за время постройки: бот уже перевёл строку в deleting
# или удалил. Запуск удалённого приложения — оживление.
STATUS=$(curl -s "$API_URL/apps" \
    -H "Authorization: Bearer $API_KEY" \
    --connect-timeout 5 --max-time 10 | \
    python3 -c "
import json, sys
try:
    apps = json.load(sys.stdin)
    for a in apps:
        if a['id'] == $APP_ID:
            print(a['status'])
            break
    else:
        print('gone')
except:
    print('error')
" 2>/dev/null) || STATUS="error"

if [ "$STATUS" != "active" ]; then
    echo "ОШИБКА: приложение $NAME (id=$APP_ID) — '$STATUS', не active." >&2
    echo "Не запускаю. Удалите и создайте заново." >&2
    exit 1
fi

# ====================== 4. SYSTEMD UNIT ========================================
# DynamicUser=yes: свой uid и StateDirectory, без sudo, sandbox systemd.
# Slice: лимиты CPU/памяти/задач — одни на все приложения (agentapps.slice).
sudo tee "$UNIT_FILE" > /dev/null <<EOF
[Unit]
Description=Agent web application $NAME (id=$APP_ID)
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=agent-apps/$APP_ID
Slice=agentapps.slice
WorkingDirectory=$APP_DIR
ExecStart=$APP_DIR/venv/bin/uvicorn main:app --host 0.0.0.0 --port $PORT --root-path "$BASE_PATH" --workers 1 --no-access-log
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
EOF

# Slice для лимитов — если раскатка не создала
if ! systemctl is-active agentapps.slice >/dev/null 2>&1; then
    sudo tee /etc/systemd/system/agentapps.slice > /dev/null <<'EOF'
[Unit]
Description=Resource limits for agent web applications

[Slice]
CPUQuota=100%
MemoryMax=512M
MemorySwapMax=0
TasksMax=128
EOF
fi

sudo systemctl daemon-reload
sudo systemctl enable --now "$UNIT_NAME" 2>/dev/null || sudo systemctl restart "$UNIT_NAME"

# ====================== HEALTH CHECK ==========================================
HEALTH_URL="http://127.0.0.1:$PORT/app-health"
TIMEOUT=30
ELAPSED=0

echo -n "Ожидание здоровья"
while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
    if curl -sf "$HEALTH_URL" >/dev/null 2>&1; then
        echo " — OK"
        echo ""
        echo "Приложение «$NAME» опубликовано."
        echo "Ссылка: $APP_URL"
        echo ""
        echo "Отдайте ссылку владельцу — её откроет кто угодно."
        exit 0
    fi
    echo -n "."
    sleep 1
    ELAPSED=$((ELAPSED + 1))
done

echo " — НЕ ОТВЕЧАЕТ" >&2
echo "" >&2
echo "ОШИБКА: приложение не прошло health-проверку за ${TIMEOUT}с." >&2
echo "Журнал: sudo journalctl -u $UNIT_NAME --no-pager -n 20" >&2
echo "Ссылку НЕ выдавайте." >&2
exit 1
